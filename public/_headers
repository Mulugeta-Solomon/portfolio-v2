# Cloudflare Pages headers. Applied top-to-bottom; later rules add to earlier.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; frame-src 'none'; manifest-src 'self'; upgrade-insecure-requests

# Content-hashed build output — safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Optimized images carry a content hash in the filename — safe to cache forever.
/assets/opt/*
  Cache-Control: public, max-age=31536000, immutable

# Root-level convention files (favicon, apple-touch-icon, OG card) live at stable,
# un-hashed URLs — not immutable, but content-stable, so cache a day and revalidate
# in the background rather than falling through to the no-cache default.
/icon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/apple-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/opengraph-image.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Resume PDF is served at a content-hashed URL (…?v=<hash>, set in next.config.mjs), so
# each version is a unique URL — cache it forever; a new resume gets a new URL that the
# (uncached) HTML points at immediately, so updates go live with no stale edge cache.
/assets/Mulugeta-Solomon-Abate-Resume.pdf
  Cache-Control: public, max-age=31536000, immutable

# Other stable-name assets — a day fresh, then revalidate in the background.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
